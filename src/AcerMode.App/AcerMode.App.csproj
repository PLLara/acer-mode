<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AcerMode</AssemblyName>
    <RootNamespace>AcerMode.App</RootNamespace>
    <Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AcerMode.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AcerMode.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcerMode.Core\AcerMode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

</Project>
