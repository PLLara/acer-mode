<UserControl x:Class="AcerMode.App.Controls.TelemetryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls"
             x:Name="Self">
    <!-- Cartão de telemetria: ícone, rótulo, valor e o histórico recente na cor do sensor. -->
    <Border CornerRadius="14" Background="#121A20" BorderBrush="#303B47" BorderThickness="1" Padding="12,10,12,0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <c:Icon DockPanel.Dock="Left" Data="{Binding IconData, ElementName=Self}" Foreground="{Binding Accent, ElementName=Self}"
                        Width="26" Height="26" StrokeThickness="1.6" Margin="0,3,9,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="StaleTag" Text="Desatualizado" FontSize="10.5" Foreground="#F5B83D"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Title, ElementName=Self}" FontSize="13" Foreground="#B3BDC9"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:AnimatedNumber x:Name="Number" Value="{Binding Value, ElementName=Self}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="#F4F6F8"/>
                        <TextBlock Text="{Binding Unit, ElementName=Self}" FontSize="14" FontWeight="SemiBold" Foreground="#F4F6F8"
                                   VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <c:Sparkline x:Name="Chart" Grid.Row="1" Height="40" Margin="-12,4,-12,0" VerticalAlignment="Bottom"
                         Series1="{Binding Series, ElementName=Self}" Stroke1="{Binding Accent, ElementName=Self}"
                         LineThickness="1.5" Capacity="60" ShowGuides="False"/>
        </Grid>
    </Border>
</UserControl>
