<UserControl x:Class="AcerMode.App.Pages.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- perfil em edição -->
        <DockPanel Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndependentLighting}" VerticalAlignment="Top" Margin="0,4,0,0">
                <TextBlock Text="Independente do modo" Foreground="{StaticResource Text2Brush}" FontSize="12"/>
            </CheckBox>
            <TextBlock Text="Perfil" Foreground="{StaticResource Text2Brush}" FontSize="12" VerticalAlignment="Top" Margin="0,7,12,0"/>
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Modes}" SelectedItem="{Binding EditingMode}"
                     IsEnabled="{Binding EditingProfiles}"/>
        </DockPanel>

        <!-- teclado -->
        <Border Grid.Row="1" Height="176" Margin="0,0,0,14">
            <c:KeyboardPreview x:Name="Keyboard" Interactive="{Binding ShowsZones}" Profile="{Binding Profile}" SelectedZone="{Binding SelectedZone}"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- cor -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid IsEnabled="{Binding ShowsColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <c:ColorWheel Width="128" Height="128" VerticalAlignment="Top" SelectedColor="{Binding Color}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding ZoneLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"/>
                            <TextBlock Text="{Binding HexError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllZones}" Margin="0,6,0,0"
                                      Visibility="{Binding ShowsZones, Converter={StaticResource Vis}}">
                                <TextBlock Text="Todas" FontSize="12" Foreground="{StaticResource Text2Brush}"/>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Bottom" IsEnabled="{Binding ShowsColor}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Swatch}" Margin="0,0,7,0"
                                        Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding}"/>
                                    </Button.Background>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- efeito -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="EFEITO" Style="{StaticResource SectionLabel}"/>
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Effects}" DisplayMemberPath="Label"
                             SelectedValuePath="Effect" SelectedValue="{Binding Effect}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Brilho" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="Velocidade" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Height="32" Padding="0,8,0,0"
                                   Visibility="{Binding ShowsSpeed, Converter={StaticResource Vis}}"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="9" Value="{Binding Speed}" SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                Visibility="{Binding ShowsSpeed, Converter={StaticResource Vis}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Speed, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding ShowsSpeed, Converter={StaticResource Vis}}"/>

                        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LeftToRight}" Margin="0,8,0,0"
                                  Visibility="{Binding ShowsDirection, Converter={StaticResource Vis}}">
                            <TextBlock Text="Da esquerda para a direita" Foreground="{StaticResource Text2Brush}"/>
                        </CheckBox>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding LiveHint}" Style="{StaticResource Muted}" Margin="2,10,0,0"/>
    </Grid>
</UserControl>
