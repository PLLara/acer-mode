<UserControl x:Class="AcerMode.App.Pages.ModesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- modo ativo -->
        <Border x:Name="Hero" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,12,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                    <c:Icon Data="{Binding ActiveIcon}" Foreground="{DynamicResource AccentBrush}" Width="28" Height="28"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MODO ATIVO" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                    <TextBlock Text="{Binding ActiveName}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,-2,0,0"/>
                    <TextBlock Text="{Binding ActiveDescription}" Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <StackPanel Orientation="Horizontal">
                            <c:AnimatedNumber Value="{Binding Telemetry.CpuTempC}" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                            <TextBlock Text=" °C" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <StackPanel Orientation="Horizontal">
                            <c:AnimatedNumber Value="{Binding Telemetry.GpuTempC}" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                            <TextBlock Text=" °C" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VENTOINHA" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <StackPanel Orientation="Horizontal">
                            <c:AnimatedNumber Value="{Binding Telemetry.CpuFanRpm}" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                            <TextBlock Text=" rpm" FontSize="13" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- dica do botão físico, na sexta célula da grade -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border x:Name="Tip" Grid.Row="1" Grid.Column="2" Margin="0,0,12,12" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}" Background="Transparent" Padding="16,14">
                <StackPanel VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Lighting}" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Left" Width="22" Height="22"/>
                    <TextBlock Text="Botão Predator" FontWeight="SemiBold" Margin="0,10,0,2" Foreground="{StaticResource Text2Brush}"/>
                    <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource Text3Brush}"
                               Text="A tecla de modo do teclado liga o Turbo. Apertada de novo, volta ao modo anterior."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- os cinco modos -->
        <ItemsControl x:Name="CardList" Grid.Row="1" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:ModeCard Margin="0,0,12,12"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
