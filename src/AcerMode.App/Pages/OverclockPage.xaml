<UserControl x:Class="AcerMode.App.Pages.OverclockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls">
    <UserControl.Resources>
        <Style x:Key="ShowIfText" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- OC de outro programa -->
        <Border Tag="{Binding ExternalWarning}" Style="{StaticResource ShowIfText}" Margin="0,0,0,14" CornerRadius="12"
                Background="{StaticResource WarningSoftBrush}" BorderBrush="#4DF5B83D" BorderThickness="1" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ZeroExternalCommand}" Padding="12,6">
                    <TextBlock Text="Zerar" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                </Button>
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Alert}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ExternalWarning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- estado e sliders -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding TurnOffCommand}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Desligar"/>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPendingChange}">
                            <TextBlock Text="Aplicar" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OVERCLOCK DA GPU" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DriverText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Núcleo" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxCore}" TickFrequency="{Binding CoreStep}" IsSnapToTickEnabled="True"
                            Value="{Binding CoreMhz}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CoreMhz, StringFormat=+{0:0} MHz}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Memória" VerticalAlignment="Center"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding MaxMem}" TickFrequency="{Binding MemStep}" IsSnapToTickEnabled="True"
                            Value="{Binding MemMhz}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MemMhz, StringFormat=+{0:0} MHz}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- proteção -->
        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="18,14">
            <DockPanel>
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Alert}" Foreground="{StaticResource Text2Brush}" Margin="0,0,14,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="Rede de segurança" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Text="O overclock só vale com o app aberto e volta sozinho a zero se a GPU passar de 85 °C, se o driver de vídeo reiniciar ou ao fechar o app. Se o notebook travar ou der tela azul com ele ligado, o app não reaplica na próxima vez. Limites: núcleo até +150 MHz, memória até +500 MHz."/>
                    <TextBlock Text="{Binding GuardStatus}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
