<UserControl x:Class="AcerMode.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls">
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanAutostart}" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Iniciar com o Windows"/>
                        <TextBlock Text="{Binding AutostartHint}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource BorderBrush}"/>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOsd}" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Mostrar aviso ao trocar de modo"/>
                        <TextBlock Text="O aviso aparece na parte de baixo da tela, sem roubar o foco." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </CheckBox>
                <Border Height="1" Background="{StaticResource BorderBrush}"/>
                <StackPanel Margin="0,10">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CpuCapEnabled}">
                        <StackPanel>
                            <TextBlock Text="Teto de frequência da CPU"/>
                            <TextBlock Text="{Binding CpuCapStatus}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                    <DockPanel Margin="0,8,0,0" IsEnabled="{Binding CpuCapEnabled}">
                        <TextBlock DockPanel.Dock="Right" Width="86" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding CpuCapMhz, StringFormat={}{0:N0} MHz, ConverterCulture=pt-BR}"/>
                        <Slider Minimum="{Binding CpuCapMin}" Maximum="{Binding CpuCapMax}" TickFrequency="100" IsSnapToTickEnabled="True"
                                SmallChange="100" LargeChange="500" Value="{Binding CpuCapMhz}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <Border Height="1" Background="{StaticResource BorderBrush}"/>
                <DockPanel Margin="0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}"
                            BorderThickness="1" Padding="12,7">
                        <TextBlock Text="{Binding RestoreLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RestoreArmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Perfis de iluminação e ventoinha"/>
                        <TextBlock Text="Volta às cores originais de cada modo e às ventoinhas no automático." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshLogCommand}" Padding="8,4" FontSize="12">
                            <TextBlock Text="Atualizar"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Padding="8,4" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Abrir pasta"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="REGISTRO DE EVENTOS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="{Binding Version}" Foreground="{StaticResource Text3Brush}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
