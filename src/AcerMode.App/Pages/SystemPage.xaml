<UserControl x:Class="AcerMode.App.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AcerMode.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Height="232" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <c:ArcGauge Value="{Binding Cpu}" Label="Processador"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <c:ArcGauge Value="{Binding Gpu}" Label="Placa de vídeo"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VENTOINHA DA CPU" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                        <c:AnimatedNumber Value="{Binding CpuRpm}" FontSize="26" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                        <TextBlock Text=" rpm" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                    <TextBlock Text="VENTOINHA DA GPU" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                        <c:AnimatedNumber Value="{Binding GpuRpm}" FontSize="26" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                        <TextBlock Text=" rpm" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                    <TextBlock Text="SISTEMA" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <c:AnimatedNumber Value="{Binding SystemTemp}" FontSize="26" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"/>
                        <TextBlock Text=" °C" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU" Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="6,0,16,0"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU" Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="ÚLTIMOS 2 MINUTOS" Style="{StaticResource SectionLabel}" Margin="0"/>
                </DockPanel>
                <c:Sparkline Grid.Row="1" Series1="{Binding CpuSeries}" Series2="{Binding GpuSeries}"/>
                <TextBlock Grid.Row="1" Text="Sensores indisponíveis: a BIOS não devolveu leituras válidas." Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Unavailable, Converter={StaticResource Vis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
