<Window x:Class="AcerMode.App.Shell.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AcerMode.App.Controls"
        Title="Acer Mode" Width="384" Height="508" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" ShowActivated="True"
        TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource Text1Brush}"
        TextElement.FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource ShellTintBrush}" RenderTransformOrigin="1,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale"/>
                <TranslateTransform x:Name="Shift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <StackPanel Margin="18,16,18,16">
            <!-- cabeçalho -->
            <DockPanel Margin="0,0,0,14">
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8" ToolTip="Abrir Acer Mode">
                    <c:Icon Data="{StaticResource Icon.Open}" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Image Source="/AcerMode.ico" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Acer Mode" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text2Brush}">
                        <Run Text="Modo"/> <Run Text="{Binding Modes.ActiveName, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- modos -->
            <ItemsControl ItemsSource="{Binding Modes.Cards}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.Modes.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Mode}" ToolTip="{Binding Description}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Surface1Brush}" BorderThickness="1"
                                            BorderBrush="{StaticResource BorderBrush}" Padding="0,10,0,8" RenderTransformOrigin="0.5,0.5">
                                        <StackPanel>
                                            <c:Icon x:Name="Ic" Data="{Binding Icon}" Width="20" Height="20" Foreground="{StaticResource Text2Brush}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Text2Brush}" x:Name="Tx"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Text1Brush}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- iluminação -->
            <TextBlock Text="ILUMINAÇÃO" Style="{StaticResource SectionLabel}"/>
            <c:KeyboardPreview x:Name="Keyboard" Height="96" Profile="{Binding Lighting.Profile}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,6">
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding QuickEffects}" DisplayMemberPath="Label"
                         SelectedValuePath="Effect" SelectedValue="{Binding Lighting.Effect}"/>
                <Button x:Name="MoreEffects" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12" Margin="0,0,0,6">
                    <TextBlock Text="Mais…"/>
                </Button>
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Lighting.Swatches}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Swatch}" Width="24" Height="24" Margin="0,0,10,0"
                                Command="{Binding DataContext.Lighting.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding}"/>
                            </Button.Background>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="Brilho" Foreground="{StaticResource Text2Brush}" Width="52" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Lighting.Brightness, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding Lighting.Brightness}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- telemetria -->
            <Border CornerRadius="10" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <c:AnimatedNumber Value="{Binding State.Latest.CpuTempC}" Format="{}{0:N0} °C" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <c:AnimatedNumber Value="{Binding State.Latest.GpuTempC}" Format="{}{0:N0} °C" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VENTOINHA" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                        <c:AnimatedNumber Value="{Binding State.Latest.CpuFanRpm}" Format="{}{0:N0} rpm" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Button x:Name="OpenMain" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch">
                <TextBlock Text="Abrir Acer Mode" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>

