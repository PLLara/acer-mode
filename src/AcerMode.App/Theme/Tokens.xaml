<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Bg0Color">#0B0D12</Color>
    <SolidColorBrush x:Key="Bg0Brush" Color="#0B0D12"/>
    <SolidColorBrush x:Key="ShellTintBrush" Color="#8C0B0D12"/>
    <SolidColorBrush x:Key="RailBrush" Color="#590B0D12"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#B3141821"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#CC1A1F2A"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#E6222835"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Text1Brush" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#A6ADBB"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#6B7280"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#29F5B83D"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
</ResourceDictionary>
